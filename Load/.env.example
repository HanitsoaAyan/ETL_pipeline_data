# Copier ce fichier à la racine du dépôt sous le nom `.env`, puis renseigner.
# Le fichier .env est exclu de Git (identifiants réels).

# Option 1 : URL de connexion complète (prioritaire si renseignée)
DATABASE_URL=

# Option 2 : variables MySQL séparées
DW_DB_HOST=localhost
DW_DB_PORT=3306
DW_DB_USER=root
DW_DB_PASSWORD=
DW_DB_NAME=datawarehouse

# Données transformées et comportement du chargeur
CLEAN_DIR=clean
DW_RESET=1
